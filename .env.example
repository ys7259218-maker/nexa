# Browser-safe Supabase configuration (never put the service-role key here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional legacy Firebase client configuration (currently unused by the UI)
NEXT_PUBLIC_FIREBASE_API_KEY=your-browser-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Server-only Meta WhatsApp Cloud API values (never prefix these with NEXT_PUBLIC_)
WHATSAPP_VERIFY_TOKEN=choose-a-random-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-registered-phone-number-id

# Server-only Supabase service-role key. Used exclusively by the WhatsApp
# webhook processor to write conversations/messages under the owning account.
# Never expose it in browser code and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Separate high-entropy Bearer secret for the internal failed-webhook retry
# endpoint. Minimum 32 characters; leave empty to keep the endpoint disabled.
WHATSAPP_RETRY_SECRET=

# AI provider used to draft replies. Keep mock until you intentionally configure
# the server-only OpenAI values. Never prefix either secret with NEXT_PUBLIC_.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# Outbound WhatsApp sending stays disabled until Meta phone registration
# completes. Keep this "false" until then.
WHATSAPP_OUTBOUND_ENABLED=false

# Enable only after applying docs/migrations/20260824_employee_lifecycle.sql.
# Safe default keeps lifecycle controls unavailable and automation paused.
EMPLOYEE_LIFECYCLE_ENABLED=false

# Enable only after applying docs/migrations/20260824_audit_events.sql.
AUDIT_LOG_ENABLED=false

# Enable only after applying docs/migrations/20260824_workspace_kill_switch.sql.
# False or missing fails closed: inbound is stored, but no AI draft is created.
WORKSPACE_SAFETY_ENABLED=false

# Enable only after applying docs/migrations/20260824_team_role_management.sql.
TEAM_MANAGEMENT_ENABLED=false

# Enable only after applying docs/migrations/20260824_employee_versions.sql
# and passing the dedicated two-account RLS/restore checks.
EMPLOYEE_VERSION_HISTORY_ENABLED=false
