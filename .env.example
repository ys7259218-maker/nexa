# Browser-safe Supabase configuration (never put the service-role key here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only Meta WhatsApp Cloud API values (never prefix these with NEXT_PUBLIC_)
WHATSAPP_VERIFY_TOKEN=choose-a-random-webhook-verification-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-registered-phone-number-id

# Server-only Supabase service-role key. Used exclusively by the WhatsApp
# webhook processor to write conversations/messages under the owning account.
# Never expose it in browser code and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Separate high-entropy Bearer secret for the internal failed-webhook retry
# endpoint. Minimum 32 characters; leave empty to keep the endpoint disabled.
WHATSAPP_RETRY_SECRET=

# AI provider used to draft replies. Keep mock until you intentionally configure
# one of the server-only providers below. Never prefix any secret with NEXT_PUBLIC_.
#   AI_PROVIDER=mock              -> built-in deterministic drafts (default)
#   AI_PROVIDER=openai            -> OpenAI Responses API (paid); set OPENAI_API_KEY + OPENAI_MODEL
#   AI_PROVIDER=openai-compatible -> any OpenAI chat-completions server (e.g. Groq, Gemini);
#                                    set AI_API_KEY + AI_MODEL + AI_BASE_URL (HTTPS origin)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# OpenAI-compatible chat-completions provider (only used when AI_PROVIDER=openai-compatible).
# Groq (free, no card):   AI_BASE_URL=https://api.groq.com/openai/v1      AI_MODEL=openai/gpt-oss-120b
# Google Gemini (free):   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                         AI_MODEL=gemini-3.8-flash
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Outbound WhatsApp sending. The approve-and-send runtime path
# (lib/server/draftSender.ts) can reach Meta only when this flag is "true" AND
# the access token AND phone number id below are both non-empty, and only after
# an operator explicitly approves a specific pending draft. Keep this "false"
# until Meta phone registration and controlled testing pass.
WHATSAPP_OUTBOUND_ENABLED=false

# Server-only outbound transport values. Never set these with a real value until
# an operator-approved known-number test passes. Keep empty/false to stay fully
# disabled.
WHATSAPP_GRAPH_VERSION=v25.0
# Optional transport tightening; unset uses the safe defaults in code.
# OUTBOUND_MAX_BODY_LENGTH=4000
# OUTBOUND_MAX_ATTEMPTS=3
# OUTBOUND_BACKOFF_MS=200
# OUTBOUND_RATE_LIMIT_WINDOW_MS=60000
# OUTBOUND_RATE_LIMIT_MAX=20

# Draft-Assist Inbound-Only V1 rollout gate (reserved; NOT wired into runtime yet).
# This is a design-only proposal documented in docs/DRAFT_ASSIST_INBOUND_ONLY_V1.md.
# Once a separately approved lifecycle/schema change lands (a non-Active employee
# may remain unpaused in a controlled test mode), an unpaused Testing employee
# correctly assigned to a test channel may generate a stored, human-reviewable
# reply with status draft_blocked. Drafts are NEVER sent automatically. The
# canonical lifecycle migration guard_ai_employee_lifecycle_write and the
# ai_employees_active_not_paused_check constraint (lifecycle_status = 'Active'
# or automation_paused = true) force a non-Active employee to stay paused today,
# so this flag has no runtime effect and must remain false. The
# closed-beta preflight gate (lib/deployPreflight.ts) fails the deploy unless
# this flag is explicitly false. Do not enable it.
INBOUND_DRAFT_ASSIST_ENABLED=false

# Enable only after applying the WhatsApp channel-assignment migration and
# passing dedicated multi-account RLS/routing tests. False/missing fails closed:
# inbound messages may be stored, but no AI Employee context or draft is used.
WHATSAPP_CHANNEL_ASSIGNMENT_ENABLED=false

# Enable only after applying docs/migrations/20260824_employee_lifecycle.sql.
# Safe default keeps lifecycle controls unavailable and automation paused.
EMPLOYEE_LIFECYCLE_ENABLED=false

# Enable only after applying docs/migrations/20260824_audit_events.sql.
AUDIT_LOG_ENABLED=false

# Enable only after applying docs/migrations/20260824_workspace_kill_switch.sql.
# False or missing fails closed: inbound is stored, but no AI draft is created.
WORKSPACE_SAFETY_ENABLED=false

# Enable only after applying docs/migrations/20260824_team_role_management.sql.
TEAM_MANAGEMENT_ENABLED=false

# Enable only after applying docs/migrations/20260824_employee_versions.sql
# and passing the dedicated two-account RLS/restore checks.
EMPLOYEE_VERSION_HISTORY_ENABLED=false

# Enable only after applying docs/migrations/20260824_knowledge_v0.sql and
# passing two-account RLS/role tests. Draft entries are never used by AI.
KNOWLEDGE_V0_ENABLED=false

# Enable only after applying the Knowledge Source Registry v1 migration and
# passing dedicated Owner/Operator/Viewer and cross-workspace RLS checks.
# This stores reference metadata only; it never enables upload or ingestion.
KNOWLEDGE_SOURCE_REGISTRY_ENABLED=false

# Enable only after applying docs/migrations/20260829_conversation_safety_controls.sql
# and passing multi-role RLS/RPC checks. False keeps the existing inbox/runtime
# behavior and makes no conversation safety columns or RPCs required.
CONVERSATION_SAFETY_ENABLED=false

# Enable only after applying the Privacy-Safe Issue Reporting v1 migration
# and passing dedicated synthetic Owner/Admin/reporter/cross-workspace RLS tests.
# False or missing keeps the report form and report reads unavailable.
ISSUE_REPORTING_ENABLED=false

# Optional privacy-safe error monitoring. Leave empty to keep Sentry disabled.
# This DSN is public by design; never put an auth token in NEXT_PUBLIC_*.
NEXT_PUBLIC_SENTRY_DSN=

# Reserved for a later, separately approved source-map upload rollout.
# The current build configuration does not upload source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Staging-only Google Calendar OAuth connection (never prefix with NEXT_PUBLIC_).
# The flow is exposed only when GOOGLE_CALENDAR_STAGING_ENABLED=true AND the
# Supabase URL exactly matches the staging ref (vbizuxxgjlwqotuegskq.supabase.co)
# AND VERCEL_ENV is not production — mirroring the review route gate. Scope is
# restricted to https://www.googleapis.com/auth/calendar.events.owned and no
# staging test-calendar ID is ever auto-selected: after consent, an operator
# explicitly stores a dedicated calendar id via POST .../configure.
# Keep CLIENT_ID/CLIENT_SECRET empty until an owner creates the OAuth client in
# Google Cloud (redirect URI:
# https://nexa-staging-preview.vercel.app/api/integrations/google-calendar/callback)
# and creates a dedicated staging test calendar. GOOGLE_CALENDAR_TOKEN_KEY is a
# 32-byte AES-256-GCM key as 64 hex chars used to encrypt stored tokens.
GOOGLE_CALENDAR_STAGING_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_TOKEN_KEY=
